# PostgreSQL connection
POSTGRES_USER=climate
POSTGRES_PASSWORD=climate
POSTGRES_DB=urban_climate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://climate:climate@localhost:5432/urban_climate

